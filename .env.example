# Optional environment overrides for mario_task.
# These OVERRIDE values in config.json but are OVERRIDDEN by CLI flags.
# Most users should configure via the first-run wizard (auto-launched on the
# first `bash run.sh`) and leave this file alone.
#
# Precedence:  defaults  <  config.json  <  .env / environment  <  CLI flags

# --- Paths -----------------------------------------------------------------
# MARIO_OUTPUT_ROOT=output
# MARIO_DATA_ROOT=data/mario.stimuli/SuperMarioBros-Nes

# --- Task ------------------------------------------------------------------
# MARIO_MAX_DURATION=600           # run duration in seconds (default 10 min)
# MARIO_FIXATION_DURATION=2
# MARIO_DISCOVERY_ENABLED=1
# MARIO_PRACTICE_ENABLED=1
# MARIO_QUESTIONNAIRE_ENABLED=1

# --- Controls --------------------------------------------------------------
# The pad is read as a keyboard, so which key drives which NES button is a
# mapping, not a single value, and lives in config.json under
#   "input": { "button_map": { "A": "x", "B": "z", "UP": "up", ... } }
# Edit it there, or on the wizard's Controls tab. Defaults: arrows to move,
# Z to run (B), X to jump (A); START and SELECT unbound.

# --- Scanner start signal (sync) -------------------------------------------
# mode:    none (start immediately, the default) | wait | send
# backend: defaults to 'none' -- no hardware, so 'wait' listens on the keyboard
#          send -> none | serial | parallel | lsl | key | markers
#          wait -> none | keyboard | serial
# MARIO_SYNC_MODE=send
# MARIO_SYNC_BACKEND=serial
# MARIO_SYNC_PORT=/dev/ttyUSB0     # serial / parallel only
# MARIO_SYNC_SIGNAL=s              # what to send, or wait for; comma-separated
                                   # for alternatives, e.g. 5,percent
# MARIO_SYNC_DUMMY_SCANS=0         # TTLs to discard before starting (wait mode)
# MARIO_SYNC_TIMEOUT=              # blank = wait indefinitely

# --- Outgoing event markers (iEEG / EEG / MEG) -----------------------------
# MARIO_TRIGGER_BACKEND=lsl        # lsl | serial | parallel | null
# MARIO_TRIGGER_PORT=/dev/ttyACM0  # Linux serial example
# MARIO_TRIGGER_PORT=/dev/parport1 # Linux parallel example
# MARIO_TRIGGER_EVERY=1            # 1 = a marker every emulator frame (60/s),
                                   # N = every Nth. Raise to relieve a
                                   # saturated amplifier.
# Per-event switches. Task start / stop always fire.
# MARIO_TRIGGER_ON_GAME_FRAME=1    # the per-frame gameplay stream
# MARIO_TRIGGER_ON_GAME_RESET=1    # one marker at the start of each attempt
# MARIO_TRIGGER_ON_NON_GAME_FLIP=1 # heartbeat on instructions / fixation flips

# LSL stream metadata (only used when the trigger backend is lsl)
# LSL_STREAM_NAME=mario_task
# LSL_STREAM_TYPE=Markers
# LSL_STREAM_SOURCE_ID=mario_task_markers

# --- Display (mostly for debugging on a single-monitor dev box) ------------
# EXP_WIN_FULLSCR=0
# EXP_WIN_SCREEN=0
# EXP_WIN_W=1280
# EXP_WIN_H=720
